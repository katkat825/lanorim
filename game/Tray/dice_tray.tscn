[node name="Dice" type="Node3D" parent="."]

; Die1 is the one the game throws most: a check, a save, an attack. Its seat is the middle of the
; near edge, straight in front of the player, because that is the die they will be watching.
[node name="Die1" parent="Dice" instance=ExtResource("2_die")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.24, 0.185)
Size = 20

; and Die2 is the second d20, for advantage and disadvantage - both are thrown and both are shown,
; because the player is owed the die that did not count as well as the one that did
