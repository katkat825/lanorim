<Project Sdk="Godot.NET.Sdk/4.7.1">
  <ItemGroup>
    <ProjectReference Include="..\content\content.csproj" />
    <ProjectReference Include="..\core\core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Game</RootNamespace>
    <AssemblyName>Lanorim</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <!-- the developer's and the checks' hooks (Dev/: the probes, the demonstration table, the picture, the registry) are
       left out of a release export, and DevHooks.Release.cs, which answers the scenes' calls with nothing, stands in
       (cc_task_j Part 2). The editor builds Debug and a debug export ExportDebug: both keep Dev/ -->
  <ItemGroup Condition=" '$(Configuration)' == 'ExportRelease' ">
    <Compile Remove="Dev/**" />
  </ItemGroup>
  <ItemGroup Condition=" '$(Configuration)' != 'ExportRelease' ">
    <Compile Remove="DevHooks.Release.cs" />
  </ItemGroup>
</Project>
