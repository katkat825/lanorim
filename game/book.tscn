[gd_scene format=3 uid="uid://bl4n0r1mbook1"]

; THE CAMPAIGN BOOK ON THE TABLE - the launch screen's backdrop (cc_task_ui-issues-9-30.md 6.3).
; Closed at the title, open under the campaign book's pages. The menu is the theme's panels laid over
; the open book, not text on its pages: pages drawn in 3D can't be read at every window size.
; Screens/BookTable.cs frames the book for the screen's shape every frame, so the camera's transform
; below is only what the editor shows. The wood, the lamp and the tone curve are the table's
; (table.tscn), so the two scenes read as one table. All of it is Kathleen's to lay out.
;
; The books are KayKit Adventurers 2.0's spellbook_closed / spellbook_open (CC0), pulled with
; tools/pull-models.ps1 into models/props/kaykit_adventurers_2_0_free/.

[ext_resource type="Script" path="res://Screens/BookTable.cs" id="1_book"]
[ext_resource type="PackedScene" path="res://models/props/kaykit_adventurers_2_0_free/spellbook_closed.gltf" id="2_closed"]
[ext_resource type="PackedScene" path="res://models/props/kaykit_adventurers_2_0_free/spellbook_open.gltf" id="3_open"]
[ext_resource type="Material" path="res://textures/table_wood067/table_wood067.tres" id="4_wood"]

[sub_resource type="PlaneMesh" id="Mesh_top"]
size = Vector2(6, 6)

[sub_resource type="Environment" id="Env_book"]
background_mode = 1
background_color = Color(0.06, 0.055, 0.05, 1)
ambient_light_source = 2
ambient_light_color = Color(0.5, 0.47, 0.42, 1)
ambient_light_energy = 0.25
tonemap_mode = 3
tonemap_exposure = 0.6

[node name="BookTable" type="Node3D"]
script = ExtResource("1_book")
ClosedModel = ExtResource("2_closed")
OpenModel = ExtResource("3_open")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_book")

[node name="Lamp" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, -0.353553, 0.353553, 0, 0.707107, 0.707107, -0.5, -0.612372, 0.612372, 0, 1.2, 0.6)
light_color = Color(1, 0.94, 0.86, 1)
light_energy = 1.55
shadow_enabled = true

[node name="TableTop" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.004, 0)
mesh = SubResource("Mesh_top")
material_override = ExtResource("4_wood")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.469472, 0.882948, 0, -0.882948, 0.469472, 0, 1.2, 0.64)
fov = 40.0
