[gd_scene format=3 uid="uid://bl4n0r1mmn101"]

; ONE PIECE ON THE MAP. A base with a figure standing on it, and the figure is measured and scaled
; to FigureHeight at _Ready - so swapping the model for a real one keeps the piece the right size
; without anything here being edited.
;
; TO LAY OUT: the Figure is a stand-in cylinder so that something stands on the map today. Replace
; it with a Quaternius character (docs/v1_minis_map.md says which model goes with which statblock)
; and put the painted-miniature shader on the Board's Paint slot - PaintedModel.Paint walks the
; whole model and overrides every mesh, so a model with six materials still comes out as one
; painted figure.
;
; The base stays. A miniature has a base, and it is the thing that makes a figure read as standing
; ON a square rather than floating over it. It is sized HERE and not derived, because Mini.Stand
; rescales only the Figure - so when board.tscn's CellSize moved from 60 mm to 150 mm the base had to
; move with it by hand. 130 mm of base on a 150 mm square, and a figure 1.25 squares tall, are the
; same proportions the 60 mm board had.

[ext_resource type="Script" path="res://Board/Mini.cs" id="1_mini"]

[sub_resource type="CylinderMesh" id="Mesh_base"]
top_radius = 0.06
bottom_radius = 0.065
height = 0.01
radial_segments = 24

[sub_resource type="StandardMaterial3D" id="Mat_base"]
albedo_color = Color(0.18, 0.17, 0.16, 1)
roughness = 0.85

[sub_resource type="CapsuleMesh" id="Mesh_standin"]
radius = 0.016
height = 0.07
radial_segments = 12
rings = 4

[sub_resource type="StandardMaterial3D" id="Mat_standin"]
albedo_color = Color(0.62, 0.58, 0.5, 1)
roughness = 0.7

[node name="Mini" type="Node3D"]
script = ExtResource("1_mini")
FigureHeight = 0.1875

[node name="Base" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.005, 0)
mesh = SubResource("Mesh_base")
material_override = SubResource("Mat_base")

[node name="Figure" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.01, 0)

[node name="Standin" type="MeshInstance3D" parent="Figure"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.035, 0)
mesh = SubResource("Mesh_standin")
material_override = SubResource("Mat_standin")

[node name="Voice" type="AudioStreamPlayer3D" parent="."]
unit_size = 0.4
max_db = -6.0
