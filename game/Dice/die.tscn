[gd_scene format=3 uid="uid://bl4n0r1md1e01"]

; One die. Its mesh, hull, mass and numerals are generated by DieBody at _Ready from DieSolid, so
; there is nothing here to lay out - changing Size in the inspector rebuilds all four.
;
; The physics material IS the feel of the dice, and ART_DIRECTION section 6 says this is where to
; spend: friction and bounce are the two dials that decide whether a throw reads as weighty or as
; a bag of plastic. Tune them by eye and ear, not by argument.

[ext_resource type="Script" path="res://Dice/DieBody.cs" id="1_die"]
[ext_resource type="Material" path="res://textures/die_onyx/die_onyx.tres" id="2_stone"]
[ext_resource type="Script" path="res://audio/DieAudio.cs" id="3_audio"]

[sub_resource type="PhysicsMaterial" id="Physics_die"]
friction = 0.55
bounce = 0.35

[node name="Die" type="RigidBody3D"]
physics_material_override = SubResource("Physics_die")
continuous_cd = true
angular_damp = 0.3
script = ExtResource("1_die")
Size = 20
Ink = Color(0.93, 0.9, 0.82, 1)

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
material_override = ExtResource("2_stone")

[node name="Audio" type="Node3D" parent="."]
script = ExtResource("3_audio")
