[internationalization]

locale/translations=PackedStringArray("res://locale/game.en.translation")

[physics]

; the dice need 120: at Godot's default 60 a d4 or d6 lying on a face rocks round its corners for good
; (game/Dice/DieBody.Wobble.cs says why). The old build ran 120 too; the harvest left this section behind
common/physics_ticks_per_second=120

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
